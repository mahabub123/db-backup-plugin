# mongodb (default) | postgres | sqlite
DATABASE_ADAPTER=mongodb
DATABASE_URL=mongodb://127.0.0.1/payload-plugin-backup
# DATABASE_ADAPTER=postgres
# DATABASE_URL=postgres://127.0.0.1:5432/payload_plugin_backup
# DATABASE_ADAPTER=sqlite
# DATABASE_URL=file:./dev/payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Backups to Cloudflare R2 (optional)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# ...or any S3-compatible bucket (AWS S3, MinIO, ...)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Lets an external cron call GET /api/backups/cron
# CRON_SECRET=
